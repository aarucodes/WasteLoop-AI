# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for development. Swap to postgres://user:pass@host/dbname for production.
DATABASE_URL=sqlite:///./wasteloop.db

# ── IBM watsonx Orchestrate ───────────────────────────────────────────────────
ORCHESTRATE_API_KEY=your_api_key_here
ORCHESTRATE_INSTANCE_URL=https://api.ibm.com/orchestrate/run/instances/your-instance-id
ORCHESTRATE_AGENT_ID=your_agent_id_here

# ── Application ───────────────────────────────────────────────────────────────
# Set to "true" to bypass Orchestrate and use a deterministic mock agent response
USE_MOCK_AGENT=true

# FastAPI base URL (used by Streamlit to call the backend)
API_BASE_URL=http://localhost:8000
